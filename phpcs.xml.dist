<?xml version="1.0"?>
<ruleset name="introibo-core">
    <description>Coding standard for introibo/core: PSR-12.</description>

    <!-- Scan the library source. Test sources are added with the first tests. -->
    <file>src</file>

    <!-- Report paths relative to the project root; run in parallel with colour. -->
    <arg name="basepath" value="."/>
    <arg name="parallel" value="4"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>
</ruleset>
