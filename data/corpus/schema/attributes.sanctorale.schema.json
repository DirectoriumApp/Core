{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schema.directorium.app/corpus/attributes.sanctorale.schema.json",
  "title": "Sanctoral edition attributes (Layer 2)",
  "description": "Per-edition rank/colour for a sanctoral observance, keyed by id within the edition directory. rank and colour are always cited; a nameOverride, when present, must cite nameOverride.la.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rank", "colour", "cites"],
  "properties": {
    "id": {
      "description": "Foreign key to a sanctoral identity record.",
      "type": "string",
      "pattern": "^roman:sanctorale:[a-z0-9]+(-[a-z0-9]+)*(:[a-z0-9]+(-[a-z0-9]+)*)*$"
    },
    "rank": { "$ref": "#/$defs/rank" },
    "legacyRank": { "$ref": "#/$defs/legacyRank" },
    "colour": { "$ref": "#/$defs/colour" },
    "nameOverride": { "$ref": "#/$defs/names" },
    "cites": {
      "allOf": [
        { "$ref": "#/$defs/cites" },
        { "required": ["rank", "colour"] }
      ]
    }
  },
  "allOf": [
    {
      "if": { "required": ["nameOverride"] },
      "then": { "properties": { "cites": { "required": ["nameOverride.la"] } } }
    },
    {
      "if": { "required": ["legacyRank"] },
      "then": { "properties": { "cites": { "required": ["legacyRank"] } } }
    }
  ],
  "$defs": {
    "rank": {
      "description": "RankClass ordinal (1 = class I, highest ... 4 = class IV). For a legacy (pre-1960) edition this is the NORMALIZED class of the legacyRank grade.",
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "legacyRank": {
      "description": "The native pre-1960 grade token, retained verbatim for fidelity (the numeric rank is its normalized RankClass). Absent for the 1960 edition; present for 1954/1955. See LegacyRank.",
      "enum": [
        "duplex-i-classis", "duplex-ii-classis", "duplex-maius", "duplex",
        "semiduplex", "simplex", "vigilia", "feria-maior", "dominica-maior",
        "dominica-minor", "commemoratio"
      ]
    },
    "colour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base"],
      "properties": {
        "base": {
          "description": "A stored base colour; rose is NEVER a base (it is expressed via roseAllowed on violet).",
          "enum": ["white", "red", "green", "violet", "black"]
        },
        "roseAllowed": { "type": "boolean" }
      }
    },
    "names": {
      "type": "object",
      "required": ["la"],
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2}(-[A-Za-z0-9]+)*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9.]+)*(:[^\\s]+)?$"
    },
    "cites": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^(rank|colour|legacyRank)$|^nameOverride\\.[a-z]{2}(-[A-Za-z0-9]+)*$" },
      "additionalProperties": { "$ref": "#/$defs/sourceRef" }
    }
  }
}
