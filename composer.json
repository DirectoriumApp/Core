{
    "name": "introibo/core",
    "description": "The Introibo liturgical engine: a clean-room PHP library computing the traditional Roman calendar.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "keywords": [
        "liturgical",
        "calendar",
        "catholic",
        "ordo",
        "computus"
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.12",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Introibo\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Introibo\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "check": [
            "@lint",
            "@analyse"
        ]
    },
    "scripts-descriptions": {
        "lint": "Check coding standards (PSR-12) with PHP_CodeSniffer.",
        "lint:fix": "Auto-fix coding-standard violations with phpcbf.",
        "analyse": "Run PHPStan static analysis at the configured level.",
        "check": "Run all quality gates locally (lint + analyse)."
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
