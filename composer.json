{
    "name": "introibo/core",
    "description": "The Introibo liturgical engine: a clean-room PHP library computing the traditional Roman calendar.",
    "type": "library",
    "license": "AGPL-3.0-or-later",
    "keywords": [
        "liturgical",
        "calendar",
        "catholic",
        "ordo",
        "computus"
    ],
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "opis/json-schema": "^2.3",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "Introibo\\Core\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Introibo\\Core\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "test": "phpunit --testsuite introibo-core",
        "validate-oracles": "phpunit --testsuite validation",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "lint": "Check coding standards (PSR-12) with PHP_CodeSniffer.",
        "lint:fix": "Auto-fix coding-standard violations with phpcbf.",
        "analyse": "Run PHPStan static analysis at the configured level.",
        "test": "Run the PHPUnit test suite.",
        "validate-oracles": "Re-prove the engine against the pinned oracles (the #45 validation harness).",
        "check": "Run all quality gates locally (lint + analyse + test)."
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
