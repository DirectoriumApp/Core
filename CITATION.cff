version: 0.1.0 # x-release-please-version
repository-code: "https://github.com/DirectoriumApp/Core"
url: "https://directorium.org"
license: AGPL-3.0-or-later
keywords:
  - liturgical calendar
  - traditional Roman rite
  - computus
  - ordo
